# build outputs
/bin/
/web/node_modules/
# web/dist/ (the built frontend) IS committed: `go install` compiles module
# source only and can't run the JS build, so the bundle must live in the repo
# for the installed binary to include the UI. Rebuild with `make web` and
# commit the result whenever the frontend changes. (Release tarballs go to the
# repo-root /dist/, ignored below.)

# runtime data — never commit a database or a master key
/data/
*.db
*.db-wal
*.db-shm
master.key

# editor / os
.DS_Store
*.swp
.idea/
.vscode/
/dist/
